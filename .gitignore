# Build outputs — generated per deploy by scripts/build-shop.js from
# data/shops/<SHOP_SLUG>/ and templates/. Both Cloudflare Pages projects run
# `npm run build`, so these are regenerated on every deploy and are NOT
# committed (a committed copy goes stale and can be served by mistake).
data/_active/
public/assets/
public/logo.png
public/menu-visual.json
public/index.html
public/order.html
public/thank-you.html
public/reset-password.html
public/staff/index.html
public/staff/manifest.json

# NOT generated — these static files are served as-is and stay tracked:
#   public/_headers  public/_redirects  public/robots.txt
#   public/sitemap.xml  public/privacy.html  public/terms.html
