# Cloudflare Pages headers config. Source of truth — scripts/build-shop.js
# copies this to public/_headers on each build, and public/_headers is
# gitignored.
#
# It lives here rather than in public/ for the same reason robots.txt does: the
# Lumin owner console build (PLATFORM_BUILD=1) writes a noindex version into the
# same public/ directory, and while this file was committed, running that build
# locally and then `git add -A` committed a site-wide noindex to every shop.
# That happened once (commit ddc4745). Generated + gitignored, it cannot.
# tests/indexability.test.mjs guards this file.
#
# https://developers.cloudflare.com/pages/configuration/headers/

# HTML / default: never edge-cache so deploys are immediately visible.
# (Browsers can still cache for a few seconds; this just stops the CDN
# from serving stale order.html for 5 min after every push.)
/*
  X-Robots-Tag: index, follow
  Cache-Control: no-store, must-revalidate

/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/staff/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=60
